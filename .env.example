# Trino Facilities — todas as variáveis de ambiente que o site e o agendador leem.
#
# Copie para .env (que NUNCA vai para o git: está no .gitignore) e preencha só
# o que precisar. Valor vazio = o padrão do sistema. Nenhum segredo aqui:
# chaves e senhas ficam só nas variáveis da hospedagem (Railway › Variables)
# e no cofre offline do dono. O que é obrigatório em produção e onde clicar:
# docs/CONFIG-MANUAL.md. O teste tests/test_env_example.py confere que toda
# variável lida no código está nesta lista.

# ── Obrigatórias em produção ─────────────────────────────────────────────
# Endereço do Postgres (o site usa este; com pooler, a URL "pooled").
DATABASE_URL=
# Chave das sessões, a MESMA no web e no agendador (Railway: ${{secret(64)}}).
SECRET_KEY=
# Chave da cifra dos campos sensíveis; obrigatória na imagem de produção. Gerar: flask --app facilities chaves gerar
FIELD_ENCRYPTION_KEY=
# Já vem ligada no Dockerfile: marca "isto é produção" (exige DATABASE_URL, SECRET_KEY e a chave da cifra).
EXIGIR_DATABASE_URL=

# ── Cifra dos campos (docs/SEGURANCA_DADOS.md) ──────────────────────────
# Chaves antigas, separadas por vírgula, só durante o rodízio (depois do "chaves girar", tirar).
FIELD_ENCRYPTION_OLD_KEYS=
# EMERGÊNCIA: 1 deixa a produção subir sem FIELD_ENCRYPTION_KEY (alerta no log a cada boot). Tirar logo.
CIFRA_OPCIONAL=

# ── Banco: conexão, pool e tempos limite (docs/BANCO_E_POOLER.md) ───────
# URL direta, sem pooler, para o agendador e os comandos flask (migrações).
DIRECT_DATABASE_URL=
# Modo TLS da conexão (require, verify-full...); vazio = require quando o banco está fora da rede interna.
DATABASE_SSLMODE=
# Força quem abre o banco: web, agendador ou cli (vazio = descobre pelo comando).
FACILITIES_PROCESSO=
# Conexões guardadas por processo (padrão: o número de threads).
DB_POOL_SIZE=
# Conexões extras além do pool (padrão 2).
DB_MAX_OVERFLOW=
# Segundos de espera por conexão livre no pool (padrão 5).
DB_POOL_TIMEOUT=
# Segundos até trocar uma conexão parada (padrão 300).
DB_POOL_RECYCLE=
# Segundos para o banco atender uma conexão nova (padrão 5).
DB_CONNECT_TIMEOUT=
# Milissegundos até derrubar conexão cujo outro lado sumiu (padrão 15000).
DB_TCP_USER_TIMEOUT_MS=
# Limite de cada consulta do agendador/comandos, com DIRECT_DATABASE_URL (padrão 5min; 0 tira).
DB_TAREFAS_STATEMENT_TIMEOUT=
# Espera de trava do agendador/comandos (padrão 1min).
DB_TAREFAS_LOCK_TIMEOUT=
# Transação parada do agendador/comandos (padrão 10min).
DB_TAREFAS_IDLE_TIMEOUT=

# ── Servidor web (gunicorn, docker-entrypoint.sh) ───────────────────────
# Porta HTTP (o Railway define sozinho; padrão 8080).
PORT=
# Processos do gunicorn (padrão 4).
WEB_CONCURRENCY=
# Threads por processo (padrão 8; o pool do banco acompanha).
GUNICORN_THREADS=
# Segundos até o gunicorn cortar uma requisição (padrão 30).
GUNICORN_TIMEOUT=
# Segundos para terminar o que está em andamento ao desligar (padrão 25).
GUNICORN_GRACEFUL_TIMEOUT=
# Segundos de keep-alive (padrão 5).
GUNICORN_KEEPALIVE=
# Número de proxies de confiança na frente do app (Railway: 1). Vazio = nenhum.
PROXY_HOPS=
# Versão fixa mostrada ao aplicativo instalado (vazio = calculada pelos arquivos).
FACILITIES_VERSAO=

# ── Sessão, login e limites de acesso ───────────────────────────────────
# Cookie só por https (padrão ligado; 0 só no desenvolvimento local em http).
SESSION_COOKIE_SECURE=
# Segunda etapa obrigatória para a gestão (padrão ligado; 0 só nos testes).
MFA_OBRIGATORIO_GESTAO=
# Liga os limites de tentativas (padrão ligado).
RATELIMIT_ENABLED=
# Onde os limites contam: memory:// (por processo) ou redis://... (comum a todos).
RATELIMIT_STORAGE_URI=memory://
# 1 recusa subir a produção sem Redis nos limites.
RATELIMIT_EXIGIR_COMPARTILHADO=
# Redis fora: o limitador engole o erro em vez de dar 500 (padrão ligado).
RATELIMIT_SWALLOW_ERRORS=
# Redis fora: conta em memória até ele voltar (padrão ligado).
RATELIMIT_IN_MEMORY_FALLBACK_ENABLED=
# Portal do cliente: 1 deixa a conta de cliente entrar (só com os termos do jurídico).
CLIENTE_EXTERNO_LIBERADO=

# ── Primeiro administrador (docs/DEPLOY_RAILWAY.md, passo 7) ────────────
# E-mail do primeiro administrador; só age quando não há administrador ativo.
ADMIN_INICIAL_EMAIL=
# Nome dele.
ADMIN_INICIAL_NOME=
# Senha temporária (8+); vazio = sorteada e mostrada uma vez no log do deploy.
ADMIN_INICIAL_SENHA=

# ── Fotos e anexos ──────────────────────────────────────────────────────
# local (disco/volume) ou r2 (Cloudflare R2). Com Postgres, local só escrito aqui.
STORAGE_BACKEND=
# Pasta dos anexos no disco (Railway: /data/uploads, no volume).
UPLOAD_FOLDER=
# Endereço do R2 principal (https://<conta>.r2.cloudflarestorage.com).
R2_ENDPOINT=
# Chave de acesso do R2 principal.
R2_ACCESS_KEY_ID=
# Segredo do R2 principal.
R2_SECRET_ACCESS_KEY=
# Bucket do R2 principal.
R2_BUCKET=
# Prefixo das chaves no bucket (opcional).
R2_PREFIX=
# Segundos para conectar ao R2 (padrão 3).
R2_CONNECT_TIMEOUT=
# Segundos de leitura do R2 (padrão 10).
R2_READ_TIMEOUT=
# Novas tentativas no R2 depois da primeira (padrão 2).
R2_TENTATIVAS=
# 1 copia uma vez por dia os anexos do volume para o R2 (precisa das R2_*).
ANEXOS_ESPELHO_R2=
# Intervalo da cópia, em segundos (padrão 86400).
ANEXOS_ESPELHO_INTERVALO=

# ── Arquivo das fotos antigas (docs/ARQUIVO_FOTOS.md) ───────────────────
# Endereço do bucket R2 SEPARADO do arquivo.
ARQUIVO_R2_ENDPOINT=
# Chave de acesso do bucket do arquivo.
ARQUIVO_R2_ACCESS_KEY_ID=
# Segredo do bucket do arquivo.
ARQUIVO_R2_SECRET_ACCESS_KEY=
# Bucket do arquivo.
ARQUIVO_R2_BUCKET=
# Prefixo no bucket do arquivo (opcional).
ARQUIVO_R2_PREFIX=
# Pasta do arquivo no servidor, só para testar o caminho (ex.: /data/arquivo-fotos).
ARQUIVO_FOTOS_PASTA=
# 1 confirma que a pasta do arquivo está noutro disco permanente.
ARQUIVO_FOTOS_PASTA_OUTRO_DISCO=
# Fotos por rodada (padrão 200).
ARQUIVO_FOTOS_POR_RODADA=
# 1 faz o próprio web andar com o lote (quando as fotos estão no volume dele).
ARQUIVO_FOTOS_NO_WEB=
# Intervalo desse laço, em segundos (padrão 300).
ARQUIVO_FOTOS_INTERVALO=

# ── Avisos no celular (Web Push) — no web E no agendador ────────────────
# Chave pública VAPID (flask --app facilities push chaves).
VAPID_PUBLIC_KEY=
# Chave privada VAPID (mesmo comando).
VAPID_PRIVATE_KEY=
# Contato do remetente, ex.: mailto:facilities@grupotrino.com.br
VAPID_SUBJECT=
# Segundos de espera por aparelho (padrão 3).
PUSH_TIMEOUT=
# Aparelhos avisados ao mesmo tempo (padrão 8).
PUSH_PARALELO=
# Espera máxima pelo conjunto, em segundos (padrão: PUSH_TIMEOUT + 2).
PUSH_TEMPO_MAXIMO=

# ── E-mail dos convites (opcional) ──────────────────────────────────────
# Servidor SMTP; vazio = o convite sai pelo WhatsApp/e-mail do aparelho.
SMTP_HOST=
# Porta (padrão 587).
SMTP_PORT=
# 1 se o provedor usar SSL direto (porta 465).
SMTP_SSL=
# Usuário do SMTP.
SMTP_USUARIO=
# Senha do SMTP.
SMTP_SENHA=
# Remetente, ex.: Trino Facilities <nao-responda@grupotrino.com.br>
SMTP_REMETENTE=
# Segundos de espera pelo servidor (padrão 10).
SMTP_TIMEOUT=

# ── Retenção (o agendador apaga depois do prazo; 0 desliga) ─────────────
# Dias até apagar a foto do aviso do público já resolvido (padrão 90).
RETENCAO_FOTO_OCORRENCIA_DIAS=
# Dias de registro de acesso da API de integração (padrão 365).
RETENCAO_ACESSO_API_DIAS=
# Dias de registro das rodadas do agendador (padrão 90).
RETENCAO_RODADA_DIAS=
